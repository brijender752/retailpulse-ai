AIRFLOW_UID=50000

# Existing RetailPulse Docker network.
# Change this only if `docker network ls` shows a different name.
RETAILPULSE_NETWORK=retailpulse-ai_retailpulse

AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@retailpulse.local

RETAILPULSE_POSTGRES_HOST=postgres
RETAILPULSE_POSTGRES_PORT=5432
RETAILPULSE_POSTGRES_DB=retailpulse
RETAILPULSE_POSTGRES_USER=retailpulse
RETAILPULSE_POSTGRES_PASSWORD=retailpulse

RETAILPULSE_DEBEZIUM_URL=http://debezium:8083
RETAILPULSE_DEBEZIUM_CONNECTOR=retailpulse-postgres-connector

RETAILPULSE_KAFKA_HOST=kafka
RETAILPULSE_KAFKA_PORT=9092

RETAILPULSE_FLINK_URL=http://flink-jobmanager:8081
RETAILPULSE_FLINK_CONTAINER=retailpulse-flink-jobmanager

RETAILPULSE_MINIO_ENDPOINT=minio:9000
RETAILPULSE_MINIO_ACCESS_KEY=minioadmin
RETAILPULSE_MINIO_SECRET_KEY=minioadmin
RETAILPULSE_MINIO_SECURE=false
RETAILPULSE_MINIO_BUCKET=retailpulse
